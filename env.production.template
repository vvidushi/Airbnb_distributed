# Production Environment Variables for AWS EC2 Deployment
# Copy this file to .env.production and fill in your actual values

# ===== SERVER CONFIGURATION =====
NODE_ENV=production
PORT=5000

# ===== MONGODB (Local Container) =====
# MongoDB runs as a Docker container on EC2
# Password will be auto-generated during deployment
MONGO_PASSWORD=airbnb_mongo_2024

# ===== SESSION & SECURITY =====
# Generate a strong random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION

# Internal API key for AI Agent communication
INTERNAL_API_KEY=CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION

# ===== KAFKA CONFIGURATION =====
KAFKA_BROKER=kafka:9092

# ===== FRONTEND CONFIGURATION =====
# Your EC2 public IP or domain
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000

# React build-time variables
REACT_APP_API_URL=http://YOUR_EC2_PUBLIC_IP:5001
REACT_APP_AI_URL=http://YOUR_EC2_PUBLIC_IP:8000

# ===== AI AGENT (OPTIONAL) =====
# Leave empty if not using AI features
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# ===== NOTES =====
# 1. Never commit .env.production with real credentials to Git!
# 2. SQLite is used automatically - no configuration needed
# 3. MongoDB runs in Docker container (128MB RAM limit, optimized for <100MB data)
# 4. Generate secrets: openssl rand -base64 32
# 5. MongoDB password auto-generated by deployment script

